{
  "datasets": [
    {
      "name": "3f95aacd",
      "displayName": "ds_overview",
      "queryLines": [
        "SELECT *,\r\n",
        "       concat(sources_ok, ' / ', sources) AS sources_ok_label\r\n",
        "FROM workspace.monitoring_ai.system_overview"
      ]
    },
    {
      "name": "96313fe5",
      "displayName": "ds_source_health",
      "queryLines": [
        "SELECT source_name, provider, quota_group, unit, health,\r\n",
        "       CASE health WHEN 'blocked' THEN 1 WHEN 'errors' THEN 2 WHEN 'never_loaded' THEN 3\r\n",
        "                   WHEN 'delayed' THEN 4 ELSE 5 END AS health_order,\r\n",
        "       last_run_at, data_loaded_until, expected_data_until, days_behind,\r\n",
        "       pending_error_chunks, pending_deferred_chunks, blocked_until\r\n",
        "FROM workspace.monitoring_ai.source_health\r\n",
        "ORDER BY health_order, source_name"
      ]
    },
    {
      "name": "471da9b1",
      "displayName": "ds_table_freshness",
      "queryLines": [
        "SELECT table_name, table_type, rows_count, data_sources, latest_data_utc, last_changed_at, quarantined_rows,\r\n",
        "       round((unix_timestamp(current_timestamp()) - unix_timestamp(last_changed_at)) / 3600, 1) AS hours_since_change\r\n",
        "FROM workspace.monitoring_ai.table_freshness\r\n",
        "ORDER BY table_type DESC, table_name"
      ]
    }
  ],
